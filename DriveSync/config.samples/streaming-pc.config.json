{
  "LogDir": "C:\\logs\\Thrive",
  "Defaults": {
    "Transfers": 4,
    "Retries": 3,
    "DriveChunkSizeMB": 64
  },
  "Retention": [
    {
      "Name": "NAS MKV archive - keep 1 year",
      "Path": "\\\\10.1.10.143\\Public\\Wyatt\\ThriveLiveBackups\\Recordings",
      "Include": "*.mkv",
      "MaxAgeDays": 365
    },
    {
      "Name": "Drive MKV archive - keep 1 year",
      "Path": "gdrive:Archive/Recordings",
      "Include": "*.mkv",
      "MaxAgeDays": 365
    }
  ],
  "Jobs": [
    {
      "Name": "Raw MKV recordings to NAS archive",
      "Mode": "move",
      "Source": "C:\\Users\\wyatt\\Videos",
