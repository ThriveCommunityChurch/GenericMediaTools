      "Include": "*.mkv",
      "MinAgeMinutes": 10,
      "MinFileSize": "100b"
    },
    {
      "Name": "NAS MKV archive to Drive",
      "Mode": "copy",
      "Source": "\\\\10.1.10.143\\Public\\Wyatt\\ThriveLiveBackups\\Recordings",
      "Destination": "gdrive:Archive/Recordings",
      "Include": "*.mkv",
      "MinAgeMinutes": 10,
      "MinFileSize": "100b",
